{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "src/App.css",
    "src/logo.svg",
    "src/react-app-env.d.ts",
    "src/reportWebVitals.ts",
    "src/setupTests.ts",
    "src/utils.ts",
    "src/index.tsx",
    "src/hooks",
    "src/components/AppLayout.tsx",
    "src/components/ExpandMore.tsx",
    "src/components/MyArchievments.tsx",
    "src/components/MyStoryLine.tsx",
    "src/components/MySummary.tsx",
    "src/components/GermanoCard.tsx",
    "src/components/ProjectCard.tsx",
    "src/components/SelectableImage.tsx"
  ]
}
